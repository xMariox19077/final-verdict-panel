@model IEnumerable<FinalVerdictPanel.Models.TeamMember>

@{
    ViewData["Title"] = "The Final Verdict - Ekip Paneli";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-4 col-md-5 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Veri Filtreleme (Backend)</h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-controller="Home" asp-action="Index">
                        <div class="mb-3">
                            <label class="form-label">İsim ile Ara</label>
                            <input type="text" class="form-control" name="searchInput" placeholder="Örn: Muhammet">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Rol / Kategori Seçimi</label>
                            <select class="form-select" name="roleSelect">
                                <option value="Tümü">Tümü</option>
                                <option value="Frontend">Frontend Developer</option>
                                <option value="Backend">Backend Developer</option>
                                <option value="Tasarım">Tasarımcı</option>
                                <option value="Yönetim">Proje Yöneticisi</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label d-block">Durum</label>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="statusRadio" value="Tümü" checked>
                                <label class="form-check-label">Hepsi</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="statusRadio" value="Aktif">
                                <label class="form-check-label">Aktif</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="statusRadio" value="Pasif">
                                <label class="form-check-label">Pasif</label>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Filtrele</button>
                        <a href="/" class="btn btn-outline-secondary w-100 mt-2">Filtreleri Temizle</a>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8 col-md-7">
            @if (!Model.Any())
            {
                <div class="alert alert-warning" role="alert">Aradığınız kriterlere uygun kayıt bulunamadı.</div>
            }
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-md-6 mb-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h5 class="card-title mb-0">@item.Name</h5>
                                    <span class="badge @(item.Status == "Aktif" ? "bg-success" : "bg-danger")">@item.Status</span>
                                </div>
                                <h6 class="card-subtitle mb-2 text-muted">@item.Role</h6>
                                <p class="card-text">@item.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>